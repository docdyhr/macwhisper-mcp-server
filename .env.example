# Copy to .env and adjust. Loaded automatically by direnv if you use it.

# Colon-separated list of directories the server is allowed to read from.
# Paths outside these directories are rejected.
MACWHISPER_ALLOWED_PATHS=~/Desktop:~/Downloads:~/Transcriptions

# Path to the MacWhisper CLI. If MacWhisper.app is installed in /Applications,
# the server auto-detects /Applications/MacWhisper.app/Contents/MacOS/mw. Override
# here if you installed it elsewhere or symlinked `mw` onto your PATH.
MACWHISPER_CLI=/Applications/MacWhisper.app/Contents/MacOS/mw

# Log file path. The server never writes logs to stdout (reserved for MCP protocol).
MACWHISPER_LOG_PATH=~/Library/Logs/macwhisper-mcp.log

# Disable FastMCP's PyPI update check — this server is privacy-first, no outbound calls.
FASTMCP_CHECK_FOR_UPDATES=off
